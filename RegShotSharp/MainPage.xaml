<Window x:Class="RegShotSharp.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RegShotSharp"
        mc:Ignorable="d"
        Title="RegShotSharp" Height="450" Width="800">
    <Grid>
        <GroupBox Header="Hives" Name="groupbox_hives" Margin="3,35,660,275">
            <Grid>
                <CheckBox Name="checkbox_hkcu" Content="CurrentUser" HorizontalAlignment="Left" Margin="14,0,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <CheckBox Name="checkbox_hkcr" Content="ClassesRoot" HorizontalAlignment="Left" Margin="14,20,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <CheckBox Name="checkbox_hklm" Content="LocalMachine" HorizontalAlignment="Left" Margin="14,40,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <CheckBox Name="checkbox_hku" Content="Users" HorizontalAlignment="Left" Margin="14,60,0,0" VerticalAlignment="Top" IsChecked="True"/>
                <CheckBox Name="checkbox_hkcc" Content="CurrentConfig" HorizontalAlignment="Left" Margin="14,80,0,0" VerticalAlignment="Top" IsChecked="True"/>
            </Grid>
        </GroupBox>

        <Button Name="button_saveDirectory"  Content="Capture Directory" HorizontalAlignment="Left" Margin="145,35,0,0" VerticalAlignment="Top" Click="button_saveDirectory_Click"/>
        <TextBox Name="textbox_saveDirectory" HorizontalAlignment="Left" Margin="248,35,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="542" MinLines="3"/>

        <Button Name="button_compareFile"  Content="Compare To..." HorizontalAlignment="Left" Margin="167,104,0,0" VerticalAlignment="Top" Click="button_compareFile_Click"/>
        <TextBox Name="textbox_compareFile" HorizontalAlignment="Left" Margin="248,104,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="542" MinLines="3"/>

        <Button Name="button_capture" Content="Capture" HorizontalAlignment="Left" Margin="10,164,0,0" VerticalAlignment="Top" Width="60" Click="button_capture_Click" IsEnabled="False"/>
        <Button Name="button_compare" Content="Compare" HorizontalAlignment="Left" Margin="10,189,0,0" VerticalAlignment="Top" Width="60" Click="button_compare_Click" IsEnabled="False"/>
        
        <Label Content="Output" HorizontalAlignment="Left" Margin="10,215,0,0" VerticalAlignment="Top"/>
        <TextBox Name="textbox_output" HorizontalAlignment="Center" Margin="0,246,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="780" Height="161"/>
    </Grid>
</Window>
